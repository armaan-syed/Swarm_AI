# ---- App ----
APP_NAME="Agentic AI Base"
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# ---- LLM: Ollama (default, local & free) ----
# Install: https://ollama.com
# Pull models: `ollama pull llama3.2 && ollama pull nomic-embed-text`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.2

# ---- LLM: Groq (optional fallback, free tier) ----
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Auth ----
JWT_ALGORITHM=HS256

# ---- Scheduler (RBI/SEBI/MCA source monitoring) ----
SCHEDULER_ENABLED=true
MONITOR_INTERVAL_HOURS=10
MONITOR_MAX_DOCS=5

# ---- ChromaDB (vector store) ----
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COMPANY_COLLECTION=company_documents
CHROMA_CIRCULAR_COLLECTION=regulatory_circulars
